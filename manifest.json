{
  "manifest_version": 3,
  "name": "Form Filler",
  "version":"1.1",
  "description":"Provides a drop down menu for different fields for your forms.",
  "permissions":[
    "activeTab",
    "storage"
  ],
  "action":{
    "default_popup": "popup.html"
  },
  "content_scripts":[
    {
      "matches":["<all_urls>"],
      "js":["content.js"],
      "css":["styles.css"]
    }
  ]
}