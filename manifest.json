{
  "manifest_version": 3,
  "name":"Form Filler",
  "version":"1.2",
  "description":"Fill form fields using right-click context menu.",
  "permissions":[
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "action":{
    "default_popup":"popup.html"
  },
  "background":{
    "service_worker":"background.js"
  },
  "content_scripts":[
    {
      "matches":["<all_urls>"],
      "js":["content.js"]
    }
  ]
}